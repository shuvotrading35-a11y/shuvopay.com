# ════════════════════════════════════════════════════════════
# ShuvoPay — Environment Variables
# Copy to .env and fill in all values before running.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
APP_NAME=ShuvoPay
DEBUG=false
ENVIRONMENT=production

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver for async FastAPI)
DATABASE_URL=postgresql+asyncpg://shuvopay:CHANGE_ME@postgres:5432/shuvopay

# PostgreSQL password (used by docker-compose for the postgres service)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PW@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PW

# ── JWT (RS256 — Asymmetric) ──────────────────────────────────
# Generate a key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the contents here (with \n for newlines in single-line env vars,
# or use multi-line values in a .env file)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
REPLACE_WITH_YOUR_RSA_PRIVATE_KEY_PEM
-----END RSA PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
REPLACE_WITH_YOUR_RSA_PUBLIC_KEY_PEM
-----END PUBLIC KEY-----"

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AES-256-GCM Encryption (SMS at rest) ─────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Must be exactly 64 hex characters (32 bytes)
AES_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_EXACTLY_32_BYTES

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://merchant.shuvopay.com,https://admin.shuvopay.com

# ── Allowed Hosts ─────────────────────────────────────────────
ALLOWED_HOSTS=shuvopay.com,api.shuvopay.com

# ── Admin Bootstrap ───────────────────────────────────────────
# Used by seed script and first-run setup
ADMIN_EMAIL=admin@shuvopay.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ── Match Engine ─────────────────────────────────────────────
# Amount tolerance in BDT (0 = exact match, 1.0 = ±1 BDT tolerance)
MATCH_ENGINE_TOLERANCE=0.0

# Default time window for invoices in minutes
MATCH_TIME_WINDOW_MINUTES=30

# Confidence threshold (0.0 to 1.0) — above this = auto-pay
MATCH_CONFIDENCE_THRESHOLD=0.95

# ── Webhooks ─────────────────────────────────────────────────
WEBHOOK_MAX_RETRIES=7
WEBHOOK_TIMEOUT_SECONDS=10

# ── Rate Limiting ─────────────────────────────────────────────
# Requests per minute per device for SMS report endpoint
RATE_LIMIT_SMS_REPORT=200

# Requests per minute per IP for login endpoint
RATE_LIMIT_LOGIN=5

# ── FCM (Push Notifications) ──────────────────────────────────
# Firebase Cloud Messaging server key for Android push notifications
# Get from: Firebase Console → Project Settings → Cloud Messaging
FCM_SERVER_KEY=REPLACE_WITH_YOUR_FCM_SERVER_KEY

# ── Audit Logs ────────────────────────────────────────────────
# Days to retain audit log entries
AUDIT_LOG_RETENTION_DAYS=90

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── Next.js Panel URLs ────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.shuvopay.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.shuvopay.com
